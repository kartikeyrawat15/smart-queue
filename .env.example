# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres connection string (pooled endpoint is fine).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# HMAC key for signing anonymous session cookies. Must be >= 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this invalidates every existing session (users get new identities).
SESSION_SECRET=
